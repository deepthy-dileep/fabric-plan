	/// Leaf account label as it appears in the P&L (e.g. Engineering Payroll, Seat Expansion ARR).
	column 'Account Name'
		dataType: string
		lineageTag: 7d8b430c-ee78-4e3b-9a02-b61d3988ef83
		summarizeBy: none
