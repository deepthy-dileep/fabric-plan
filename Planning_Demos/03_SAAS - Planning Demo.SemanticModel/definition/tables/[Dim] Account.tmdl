		annotation SummarizationSetBy = Automatic

	/// Account group within Level 2 (e.g. Recurring Revenue, R&D Payroll).
	column 'Level 3'
		dataType: string
		isHidden
		lineageTag: 5597f496-6c57-461b-b851-e1f6e05aae3d
		summarizeBy: none
