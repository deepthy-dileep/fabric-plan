		changedProperty = SortByColumn

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Sub-group within Level 3 (e.g. Core Platform ARR, New Logo ARR). Blank for accounts above Level 4.
	column 'Level 4'
		dataType: string
		isHidden
		lineageTag: 9288b4bb-e379-4bd2-b657-f250ce63d678
