/// Chart of accounts for the NovaTerra P&L — five levels from Total Income down to individual payroll and revenue sub-lines. All 50 accounts participate in FactFinancial. Leaf accounts are planning input rows in the Fabric Plan Financial P&L Sheet.
table '[Dim] Account'
	lineageTag: 5fbe53a9-79f6-4f99-89fd-301951fd3bed

	/// Surrogate key. Hidden — used for relationships only.
	column 'Account Key'
		dataType: string
		lineageTag: 8414f32a-4ec4-4b66-accb-25f27b51e003
		summarizeBy: none
		sourceColumn: AccountKey

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	/// Short code (e.g. RDPAY-ENG, NL-ENT). Unique per account row.
	column 'Account Code'
		dataType: string
		lineageTag: b4622f1f-4046-4086-8db3-101af8906aa1
		summarizeBy: none
		sourceColumn: AccountCode

		annotation SummarizationSetBy = Automatic

	/// Top-level P&L bucket: Total Income, Total Costs, or Profit & Tax.
	column 'Level 1'
