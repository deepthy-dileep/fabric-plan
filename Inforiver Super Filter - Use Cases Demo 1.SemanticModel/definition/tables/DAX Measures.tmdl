	measure 'Last 7 Days' = IF(SELECTEDVALUE('Date'[Date]) >= TODAY()-7 && SELECTEDVALUE('Date'[Date]) > TODAY(),1,0)
		formatString: 0
		lineageTag: 8340b000-2b58-42a0-900f-88fc8e2e2483

	measure 'Default Selection' = ```
			
			SWITCH(
			    TRUE(), 
			    AND(VALUES(SalesTerritory[Country]) = "Australia" , OR(VALUES('Product'[Category]) = "Bikes", VALUES('Product'[Category]) = "Accessories")),1,
			    AND(VALUES(SalesTerritory[Country]) = "United States" , VALUES('Product'[Category]) = "Components"),1
			    ,0)
			```
		formatString: 0
		lineageTag: 612197f1-23fb-4918-a494-5911c8359e3d

