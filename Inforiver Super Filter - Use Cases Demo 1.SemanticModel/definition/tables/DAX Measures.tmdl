	measure 'Profit Margin YOY' =
			
			VAR _ly = CALCULATE([Profit Margin], SAMEPERIODLASTYEAR('Date'[Date]))
			VAR _yoy = DIVIDE( [Profit Margin] - _ly, _ly, 0)
