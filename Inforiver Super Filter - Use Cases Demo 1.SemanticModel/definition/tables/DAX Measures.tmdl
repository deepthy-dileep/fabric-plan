	measure 'Sales value format' = ```
			
			SWITCH(
			    TRUE(),
			    [Total Sales] >= 1000000, FORMAT( [Total Sales], "#,0,,.0M"),
			    [Total Sales] >= 1000, FORMAT( [Total Sales], "#,0,.0K"),
			    FORMAT([Total Sales], "0")
			)
			
			```
		lineageTag: f2da0963-b5d8-40fe-9467-8fd8cd25a1ec

	measure 'Total Orders' = COUNTROWS(Sales)
		formatString: 0
		lineageTag: 71e521f2-d277-4882-8f56-c5aa36938e81

	measure 'Profit Margin' = DIVIDE( [Total Profit], [Total Sales], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 04d94ef1-d267-454d-bdbb-a60d6c59d6ab

	measure 'Sales LY' = CALCULATE([Total Sales], SAMEPERIODLASTYEAR('Date'[Date]))
