table 'DAX Measures'
	lineageTag: 07cf281c-13c9-46e1-b408-4f858cb0121d

	measure 'Total Sales' = SUM(Sales[Sales Amount])
		lineageTag: 94ac0328-a0f4-4053-913c-cbc6a184117e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Quantity' = SUM(Sales[Order Quantity])
		formatString: 0
		lineageTag: 08a557d0-1623-4a19-a044-93b45123d422

	measure 'Total Profit' =
			
			VAR _cost = SUM(Sales[Total Product Cost])
			RETURN
			[Total Sales] - _cost
		lineageTag: 0cd208d1-3449-4da2-94d5-25fb2351e37b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales YOY' =
			
			VAR _ly = CALCULATE([Total Sales], SAMEPERIODLASTYEAR('Date'[Date]))
			VAR _yoy = DIVIDE( [Total Sales] - _ly, _ly, 0)
			RETURN
			IF( _yoy >= 0,  FORMAT(_yoy,"0.00%") & " 🡵", FORMAT(_yoy, "0.00%") & " 🡷" )
		lineageTag: 9ae29cba-1481-4351-a233-515ef107c5a2

	measure 'Quantity YOY' =
			
			VAR _ly = CALCULATE([Total Quantity], SAMEPERIODLASTYEAR('Date'[Date]))
			VAR _yoy = DIVIDE( [Total Quantity] - _ly, _ly, 0)
			RETURN
			IF( _yoy >= 0,  FORMAT(_yoy,"0.00%") & " 🡵", FORMAT(_yoy, "0.00%") & " 🡷" )
		lineageTag: 892757f6-783d-4914-b33e-ef49c80e69c2

	measure 'Profit YOY' =
			
			VAR _ly = CALCULATE([Total Profit], SAMEPERIODLASTYEAR('Date'[Date]))
			VAR _yoy = DIVIDE( [Total Profit] - _ly, _ly, 0)
			RETURN
			IF( _yoy >= 0,  FORMAT(_yoy,"0.00%") & " 🡵", FORMAT(_yoy, "0.00%") & " 🡷" )
		lineageTag: fdb2f765-5b9b-451b-b73b-447a7b9ce582

	measure 'Sales text CF' =
			
			VAR _ly = CALCULATE([Total Sales], SAMEPERIODLASTYEAR('Date'[Date]))
			VAR _yoy = DIVIDE( [Total Sales] - _ly, _ly, 0)
			RETURN
			IF(_yoy >=0, "#31A108","#EA1E1E")
		lineageTag: 0880ec03-3b15-4521-998c-55ad48feadb8

	measure 'Quantity text CF' =
			
			VAR _ly = CALCULATE([Total Quantity], SAMEPERIODLASTYEAR('Date'[Date]))
