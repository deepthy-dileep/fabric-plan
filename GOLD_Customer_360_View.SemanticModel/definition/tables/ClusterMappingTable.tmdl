		annotation __PBI_SemanticLinks = [{"LinkTarget":{"TableName":"Orders","TableItemName":"Sub-Category (clusters)","ObjectType":4},"LinkType":"UsedInGroup"}]

	partition ClusterMappingTable = calculated
		mode: import
		source = ```
				VAR __DS0Core = 
					SUMMARIZECOLUMNS(
						'Orders'[Sub-Category],
						"v__sale", 'Orders'[__SALE],
						"v__CountRow", 'Orders'[__CountRow]
					)
				
				VAR __DataTransformT0 = 
					KMeansClustering(
						SELECTCOLUMNS(
							__DS0Core,
							"Sub_Category", 'Orders'[Sub-Category],
							"v__sale", [v__sale],
							"v__CountRow", [v__CountRow]
						),
						{("[v__sale]", "Attribute"),
							("[v__CountRow]", "Attribute"),
							("[Sub_Category]", "Item")},
						{("[Sub_Category]", BLANK()),
							("ClusterId", "ClusterId")},
						5
					)
				
				RETURN __DataTransformT0
				```
			retainDataTillForceCalculate

	annotation ClusterMappingTable = true

	annotation __PBI_SemanticLinks = [{"LinkTarget":{"TableName":"Orders","TableItemName":"Sub-Category (clusters)","ObjectType":4},"LinkType":"UsedInGroup"}]

