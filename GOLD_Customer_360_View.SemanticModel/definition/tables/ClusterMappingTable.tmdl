table ClusterMappingTable
	isHidden
	isPrivate
	lineageTag: e6707041-e101-4eb1-bc72-e3c090716972

	column Sub_Category
		lineageTag: df7ca2ab-d34a-42d8-ac43-1c351b55f646
		summarizeBy: none
		isNameInferred
		sourceColumn: [Sub_Category]

		annotation SummarizationSetBy = Automatic

		annotation __PBI_SemanticLinks = [{"LinkTarget":{"TableName":"Orders","TableItemName":"Sub-Category (clusters)","ObjectType":4},"LinkType":"UsedInGroup"}]

	column ClusterId
		formatString: 0
		lineageTag: aa9447db-e293-42c7-846d-652612fb9618
		summarizeBy: count
		isNameInferred
		sourceColumn: [ClusterId]

