	measure 'Chng %' = ```
			
			VAR one = SUM('U CIPLA'[Close])
			
			VAR two = SUM('U CIPLA'[Prev Close])
			
			VAR RESULT = DIVIDE(one - two, two, 0)
			
			RETURN
			Result 
			```
		formatString: #,0.00%;-#,0.00%;#,0.00%
