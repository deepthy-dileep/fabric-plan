table 'Measures Table'
	lineageTag: ca2bdfb0-5676-444e-ab5d-b74fa8acb7ac

	measure COGS =
			
			SUM('Fact Transactions'[COGS])
		lineageTag: 78025e5c-b90d-4575-b65b-721dac07a26e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gross Revenue' =
			
			SUM('Fact Transactions'[Gross Revenue])
		lineageTag: 893d7e6e-da3a-424c-a3c1-c4419c5bc386

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '2025 COGS' =
			
			CALCULATE(
			    SUM('Fact Transactions'[COGS]),
			    FILTER(
			        'Fact Transactions',
			        VALUE('Fact Transactions'[Date Key]) >= 202501 &&
			        VALUE('Fact Transactions'[Date Key]) <= 202512
			    )
			)
		lineageTag: 658e5a4b-0b71-4862-9065-1e55817734e8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '2025 Gross Revenue' =
			
			CALCULATE(
			    SUM('Fact Transactions'[Gross Revenue]),
			    FILTER(
			        'Fact Transactions',
			        VALUE('Fact Transactions'[Date Key]) >= 202501 &&
			        VALUE('Fact Transactions'[Date Key]) <= 202512
			    )
			)
		lineageTag: d9668a2f-88b1-4439-9472-e2c838a067ac

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Value
		isHidden
		lineageTag: 617368cb-0aad-4638-9581-964b578f44ea
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

