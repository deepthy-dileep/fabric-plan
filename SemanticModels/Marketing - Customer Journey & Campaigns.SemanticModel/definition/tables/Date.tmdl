		annotation SummarizationSetBy = Automatic

	hierarchy 'Date Hierarchy'
		lineageTag: 8cfa5b29-121d-4edd-9a86-6ec2cbc87bac

		level Year
			lineageTag: 05327959-8e5c-4140-a99c-ae98324354aa
			column: Year

		level Quarter
			lineageTag: f7ea4f97-44e2-483b-8f6c-d00558a6eda8
			column: Quarter

		level 'Month Short'
			lineageTag: 5e21a266-5944-4f29-9b80-b2970b0a97dc
			column: 'Month Short'

	partition Date = calculated
		mode: import
		source =
				
				VAR StartYear = 2023
				VAR EndYear = 2026
				
				VAR Years =
				    SELECTCOLUMNS(
				        GENERATESERIES(StartYear, EndYear, 1),
				        "Year", [Value]
				    )
				
				VAR Months =
				    SELECTCOLUMNS(
				        GENERATESERIES(1, 12, 1),
				        "Month", [Value]
				    )
				
				VAR YearMonths =
				    GENERATE(
				        Years,
				        Months
				    )
				
				RETURN
				SELECTCOLUMNS(
				    YearMonths,
				    "Date Key", [Year] * 100 + [Month],
				    "Year", [Year],
				    "Month", [Month],
				    "Month Name", FORMAT(DATE([Year], [Month], 1), "MMMM"),
				    "Quarter", "Q" & ROUNDUP([Month] / 3, 0),
				    "Year Quarter", FORMAT([Year], "0000") & "-Q" & ROUNDUP([Month] / 3, 0),
				    "Year Month", FORMAT(DATE([Year], [Month], 1), "yyyy-MM"),
				    "Half Year", IF([Month] <= 6, "H1", "H2"),
				    "Month Short", FORMAT(DATE([Year], [Month], 1), "MMM")
				)

	annotation PBI_Id = 91f53b8e8e7e48eda3aac9285d118f71

