	column 'Customer_Age (bins)' = ```
			VAR __Count = 10
			
			VAR __Min = MIN('T Sankey BankChruners_clustered'[Customer_Age])
			
			VAR __Max = MAX('T Sankey BankChruners_clustered'[Customer_Age])
			
			VAR __Difference = (__Max - __Min)
			
			VAR __Size = IF(__Difference > 0, __Difference / __Count, 1)
			
			VAR __BinNumber = 
				INT(('T Sankey BankChruners_clustered'[Customer_Age] - __Min) / __Size)
			
			RETURN
				IF(
					ISBLANK('T Sankey BankChruners_clustered'[Customer_Age]),
					BLANK(),
					__Min + (MIN(__BinNumber, __Count - 1) * __Size)
				)
			```
		lineageTag: 1d78c701-ed09-436e-8428-71014305ab18
		summarizeBy: none

