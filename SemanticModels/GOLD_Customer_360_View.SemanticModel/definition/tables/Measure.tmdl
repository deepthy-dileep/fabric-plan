	measure 'Sale Target Band' = ```
			
			VAR _sale = SUM(Orders[Sales])
			VAR _band = SWITCH(
			    true(),
			_sale < 100000, "1",
			_sale < 200000, "2",
			"3")
			return
			_band 
			// 1 for sale less than 1o lakh, 2 for less than 20 lakh , 3 for rest
			```
		displayFolder: _Sale
		lineageTag: f62548b8-5563-4cdf-a967-2ba71ac15495

