	measure 'Quantity MoM Variance' = ```
			
			 if(ISBLANK([Quantity LM]),blank(),[Total Quantity] - [Quantity LM])
			
			```
		formatString: 0
		displayFolder: _Quantity
		lineageTag: 9d3d7766-6a99-4a85-a9f4-32e7be822d65

		changedProperty = IsHidden

	measure 'Quantity MoM Variance%' = ```
			
			     IF(
			        ISBLANK([Total Quantity]), 
			            BLANK(),
			                DIVIDE([Quantity MoM Variance], [Quantity LM], BLANK() ) 
			                )
			
			```
		formatString: 0.00%;-0.00%;0.00%
