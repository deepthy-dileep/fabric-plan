	measure 'Quantity LM' = ```
			
			Var _LM = 
			    CALCULATE( [Total Quantity] , 
			        DATEADD('Order Dates'[Date], -1, MONTH)) 
			
			Var Result = IF(ISBLANK([Total Quantity]),BLANK(),_LM )
			RETURN
			Result 
			```
		formatString: 0
		displayFolder: _Quantity
		lineageTag: 8af009a2-e51c-4f16-9f7f-0a6c52125a3f

