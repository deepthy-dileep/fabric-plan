table 'U ChartWizard'
	lineageTag: 0129d272-aa49-4c82-8666-cffb41c161ef

	measure MCL =
			
			VAR _TotalField = SUM('U ChartWizard'[V Continuous]) + SUM('U ChartWizard'[C Max]) + SUM('U ChartWizard'[L Max])
			VAR _Measure = SELECTEDVALUE('U ChartWizard'[V Continuous])
			VAR _Category = SELECTEDVALUE('U ChartWizard'[C Max])
			VAR _Legend = SELECTEDVALUE('U ChartWizard'[L Max])
			VAR _Text = _TotalField & " = " & _Measure & " + " & _Category & " + " & _Legend
			
			RETURN
			_Text
		lineageTag: b5d78f75-3f15-4a9c-ba4f-ce2655ef47d5

