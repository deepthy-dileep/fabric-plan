	measure 'Commercial Opex Consistency Check' =
			
			CALCULATE (
			    [Total Amount],
			     ( '[Dim] Account'[AccountKey] IN {411,412,413,414} )
			) -
			(
			    [Advertising & Promotions] +
			    [Sales Commissions] +
			    [Trade Shows & Events] +
			    [Digital Marketing]
			)
		displayFolder: Verification Measures
