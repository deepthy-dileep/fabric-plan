	measure 'Average Discount %' =
			
			DIVIDE (
			    SUM ( '[Fact] Invoice Line'[Discount] ),
			    SUM ( '[Fact] Invoice Line'[Net Amount] )
			        + SUM ( '[Fact] Invoice Line'[Discount] )
			)
